# FinPay is intentionally locked to Razorpay TEST mode.
DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
RAZORPAY_KEY_ID="rzp_test_REPLACE_ME"
RAZORPAY_KEY_SECRET="REPLACE_TEST_SECRET"
RAZORPAY_WEBHOOK_SECRET="REPLACE_TEST_WEBHOOK_SECRET"
APP_URL="http://localhost:3000"
RAZORPAY_MODE="test"
# Safety guard: production/live credentials are rejected by the app.
ALLOW_RAZORPAY_LIVE="false"
